# API bind address
API_HOST=0.0.0.0
API_PORT=3000

# SQLite database path (libSQL file URL)
DATABASE_URL=file:./data/llm-upstream-monitor.db

# Login password / API Bearer token
# Default for local & portable builds: llm-monitor
# Change this if you expose the service beyond your machine
AUTH_TOKEN=llm-monitor

# AES-256-GCM key source for credentials stored in SQLite. Keep stable and secret.
ENCRYPTION_KEY=replace-with-a-long-random-secret-at-least-16-characters
